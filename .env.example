# Copy to .env next to ai_processor.py. .env is gitignored.
# A variable already set in the environment wins over this file.
# Uncomment a line to set it. Leave a line commented to keep the built-in default.

# Google AI Studio key. Gemini is skipped when this is unset.
# GEMINI_API_KEY=

# Gemini model tried first. Unset starts at gemini-3.5-flash-lite.
# HTTP 503, a used-up free quota, or 404 tries the next text model, then Ollama.
# GEMINI_REASON_MODEL=

# Mistral API key. The vision advisor is skipped when this is unset.
# MISTRAL_API_KEY=

# Mistral vision model id. Unset uses ministral-14b-2512.
# MISTRAL_VISION_MODEL=

# Ollama host:port. Unset uses 127.0.0.1:11434.
# OLLAMA_HOST=

# Ollama text model. Unset uses llama3.2.
# OLLAMA_REASON_MODEL=

# Set to off to skip the text reasoner.
# AI_EDITOR_REASONER=
